# ==============================================================================
# Kisan BhavSaathi Backend — Environment Variables Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env' inside the 'backend/' directory:
#      Copy-Item .env.example .env
# 2. Adjust settings as needed for your local environment.
# 3. DO NOT commit actual secrets or production keys to source control.
# ==============================================================================

# Application Metadata
PROJECT_NAME="Kisan BhavSaathi API"
VERSION="0.1.0"
DESCRIPTION="Backend API for Kisan BhavSaathi — SIH 2026 agricultural market platform"

# Environment Mode: 'development', 'staging', or 'production'
ENVIRONMENT="development"
DEBUG=True

# Local Server Binding
HOST="127.0.0.1"
PORT=8000

# Base API Prefix
API_V1_PREFIX="/api/v1"

# Application Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Cross-Origin Resource Sharing (CORS) Origins
# A comma-separated list of allowed origins.
# - In local development: Local frontend development servers are permitted.
# - In production: Replace with explicit production domains (e.g., https://admin.kisanbhavsaathi.in).
# Wildcard '*' is strictly discouraged for production deployments.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
